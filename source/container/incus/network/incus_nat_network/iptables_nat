# 假设从 192.168.1.x 网段访问，把 host 的 2222 端口转发到 VM 的 22
sudo iptables -t nat -A PREROUTING -i enp4s0 -p tcp --dport 2222 -j DNAT --to-destination 10.0.55.83:22
sudo iptables -t nat -A PREROUTING -i wlxfc221c500043 -p tcp --dport 2222 -j DNAT --to-destination 10.0.55.83:22
sudo iptables -A FORWARD -d 10.0.55.83 -p tcp --dport 22 -j ACCEPT
