incus network create wifi-bridge \
  ipv4.address=192.168.1.200/24 \
  ipv4.address.auto=true \
  ipv4.nat=true \
  projects=incus \
  network=bridged \
  bridge=br1

sudo ip link add br1 type bridge
sudo ip link set wlxfc221c500043 master br1
sudo ip link set br1 up
sudo dhclient br1

incus network attach wifi-bridge <vm-name> enp5s0
incus restart <vm-name>
