podman run -d \
  --name alpine-dev \
  --hostname alpine-dev \
  --net=host \
  --user 1000:1000 \
  --userns keep-id \
  -e LANG=C.UTF-8 \
  --workdir /workspace \
  -v /home/admin/docs:/workspace \
  -v /home/admin/.ssh:/home/admin/.ssh:ro \
  --cap-add SYS_PTRACE \
  --security-opt seccomp=unconfined \
  localhost/alpine-dev \
  sh -c "sleep infinity"
