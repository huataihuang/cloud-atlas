podman run -d \
  --name alpine-dev \
  --hostname alpine-dev \
  --net=host \
  --userns keep-id \
  -e LANG=C.UTF-8 \
  --workdir /workspace \
  -v /home/admin/docs:/workspace:z \
  -v admin_home_data:/home/admin \
  -v /home/admin/.ssh:/home/admin/.ssh \
  --cap-add SYS_PTRACE \
  --security-opt seccomp=unconfined \
  localhost/alpine-dev \
  sh -c "sleep infinity"
