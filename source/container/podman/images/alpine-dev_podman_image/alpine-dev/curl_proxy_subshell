RUN apk add --no-cache rust-analyzer && \
    (export http_proxy=socks5://127.0.0.1:1082 https_proxy=socks5://127.0.0.1:1082; \
    curl -fsSL https://github.com/artempyanykh/marksman/releases/latest/download/marksman-linux-x64 -o /usr/local/bin/marksman) && \
    chmod +x /usr/local/bin/marksman && \
    go install golang.org/x/tools/gopls@latest && \
    pip install --no-cache-dir --break-system-packages \
        jedi-language-server \
        ruff && \
    gem install --no-document solargraph
