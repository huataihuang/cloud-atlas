# -----------------------------------------------------------------------------
# 剪贴板跨设备同步快捷键 (iPad <-> Alpine Python Clip-Server)
# -----------------------------------------------------------------------------

# Mod4 + Shift + v: 从 Python 剪贴板服务拉取最新文本，写入 Alpine 的 Wayland 剪贴板
bindsym $mod+Shift+v exec --no-startup-id "curl -s http://127.0.0.1:9999 | wl-copy"

# Mod4 + Shift + c: 将 Alpine 当前剪贴板的内容推送到 Python 剪贴板服务（供 iPad 拉取）
bindsym $mod+Shift+c exec --no-startup-id "wl-paste | jq -sR '{text: .}' | curl -X POST -H 'Content-Type: application/json' --data-binary @- http://127.0.0.1:9999"
