{
  "log": {
    "level": "debug",
    "timestamp": true
  },
  "inbounds": [
    {
      "type": "socks",
      "tag": "socks-in",
      "listen": "127.0.0.1",
      "listen_port": 1080
    }
  ],
  "outbounds": [
    {
      "type": "selector",
      "tag": "select",
      "outbounds": ["proxy", "direct"]
    },
    {
      "type": "shadowsocks",
      "tag": "proxy",
      "server": "你的服务器IP或域名",
      "server_port": 443,
      "method": "aes-256-gcm",
      "password": "你的密码"
    },
    {
      "type": "direct",
      "tag": "direct"
    }
  ]
}
