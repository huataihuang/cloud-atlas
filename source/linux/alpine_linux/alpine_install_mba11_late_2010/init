    # 确保目标文件系统模块已加载到内核
    modprobe ${rootfstype:-ext4} 2>/dev/null

    # 如果 rootfstype 被 nlplug-findfs 清空，强制恢复
    [ -z "$rootfstype" ] && rootfstype="$KOPT_rootfstype"

    # shellcheck disable=SC2086
    $MOCK mount ${rootfstype:+-t} ${rootfstype} \
      -o "${KOPT_rootflags:-ro}" \
      "${KOPT_root#ZFS=}" "$sysroot"
