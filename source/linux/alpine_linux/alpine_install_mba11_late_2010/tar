# U盘格式化FAT32
diskutil partitionDisk /dev/disk4 GPT MBRFormat "MS-DOS FAT32" ALPINE R

# macOS 命令行自带了 7z（如果装了 Homebrew）、tar 或 bsdtar，其中 bsdtar 可以完美直接解压 ISO/isohybrid 文件，无需双击挂载
# 进入 ISO 存放目录（假设在 Downloads）
cd ~/Downloads

# 使用 bsdtar 将 ISO 内容直接解压到 U 盘根目录
bsdtar -xf alpine-standard-3.24.1-x86_64.iso -C /Volumes/ALPINE/
