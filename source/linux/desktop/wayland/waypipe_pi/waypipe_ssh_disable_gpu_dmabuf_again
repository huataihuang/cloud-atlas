# 通过 LD_PRELOAD 或禁用 libvulkan 的搜索，强制让 waypipe 找不到系统的 Vulkan 共享库
#LD_PRELOAD=/dev/null LD_LIBRARY_PATH="" waypipe --compress lz4 --video none ssh pi5 \

# 用 LD_PRELOAD 挂载一个不存在的伪库来阻止加载
LD_PRELOAD=/lib/x86_64-linux-gnu/libc.so.6 waypipe --compress lz4 ssh pi5 \
    chromium \
    --enable-features=UseOzonePlatform \
    --ozone-platform=wayland \
    --disable-gpu \
    --disable-gpu-compositing
