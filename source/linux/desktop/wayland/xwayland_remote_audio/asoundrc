cat << 'EOF' > ~/.asoundrc
# 1. 重定义默认 PCM 输出：直接通过 PulseAudio 协议路由至 127.0.0.1:4713
pcm.!default {
    type pulse
    server "127.0.0.1:4713"
}

ctl.!default {
    type pulse
    server "127.0.0.1:4713"
}

# 2. 备用硬件回退节点：显式指定为 Card 2 (Dummy)，彻底避开 Card 0/1 (HDMI)
pcm.dummy {
    type plug
    slave {
        pcm "hw:2,0"
    }
}
EOF
