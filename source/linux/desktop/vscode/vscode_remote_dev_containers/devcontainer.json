{
  "name": "Go & Python Dev Environment",
  "build": {
    "dockerfile": "Dockerfile"
  },
  
  // 容器启动后自动安装的 VS Code 插件
  "customizations": {
    "vscode": {
      "extensions": [
        "golang.go",
        "ms-python.python",
        "ms-python.vscode-pylance",
        "charliermarsh.ruff",
        "eamodio.gitlens",
        "Continue.continue"
      ],
      "settings": {
        "editor.formatOnSave": true,
        "[python]": {
          "editor.defaultFormatter": "charliermarsh.ruff"
        },
        "[go]": {
          "editor.defaultFormatter": "golang.go"
        }
      }
    }
  },

  // 映射宿主机端口到容器（方便本地预览 API 服务）
  "forwardPorts": [8000, 8080],

  // 容器启动时自动执行的初始化命令
  "postCreateCommand": "go version && python3 --version && poetry --version",

  // 以非 root 用户运行（可选，根据团队规范调整）
  "remoteUser": "root"
}
