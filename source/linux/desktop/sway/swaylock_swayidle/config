# ==============================================================================
# Swayidle 自动化策略 (锁屏 -> 熄屏 -> 休眠)
# ==============================================================================

exec swayidle -w \
    timeout 300 'swaylock -f -c 1a1b26' \
    timeout 600 'swaymsg "output * dpms off"' \
    resume 'swaymsg "output * dpms on"' \
    timeout 900 'echo mem > /sys/power/state' \
    before-sleep 'swaylock -f -c 1a1b26'
