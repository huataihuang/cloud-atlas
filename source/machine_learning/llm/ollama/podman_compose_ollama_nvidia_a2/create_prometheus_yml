cat <<EOF > ~/podman/prometheus_data/prometheus.yml
global:
  scrape_interval: 15s

scrape_configs:
  - job_name: 'node'
    static_configs:
      - targets: ['node-exporter:9100']
  - job_name: 'gpu-metrics'
    static_configs:
      - targets: ['nvidia-exporter:9400']
  - job_name: 'ollama'
    static_configs:
      - targets: ['ollama:11434']
EOF

