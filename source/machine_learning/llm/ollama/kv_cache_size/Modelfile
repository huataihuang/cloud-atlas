# 基础镜像：使用 8-bit 量化的 qwen3.8:27b
FROM qwen3.8:27b-q8_0

# ==========================================
# 1. 核心上下文与性能参数
# ==========================================
# 将上下文严格限制在 128K (131072)，平衡长代码检索与 48GB 显存安全阈值
PARAMETER num_ctx 131072

# 创造性与严谨度平衡（代码排查与编写推荐 0.2 ~ 0.3）
PARAMETER temperature 0.3
PARAMETER top_p 0.9

# ==========================================
# 2. 系统提示词（赋能资深 SRE 与全栈架构师角色）
# ==========================================
SYSTEM """
You are an elite Principal SRE and Senior Systems Engineer. You assist in writing, reviewing, and debugging high-performance Go and Python systems, container infrastructure (Podman/Docker), and Linux kernel tuning. Provide precise, production-grade, and robust code solutions with clear engineering tradeoffs.
"""
